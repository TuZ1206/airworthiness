# Copy this file to .env and fill values locally. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_me

# Dify application API (Dify performs retrieval/RAG)
DIFY_API_BASE_URL=http://localhost/v1
DIFY_API_KEY=replace_me

# Only needed when the application calls DeepSeek directly.
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
